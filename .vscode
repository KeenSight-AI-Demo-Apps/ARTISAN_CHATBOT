{
  "FastAPI Root Endpoint": {
    "prefix": "fastapi-root",
    "body": [
      "@app.get(\"/\")",
      "def root():",
      "    return {\"message\": \"Artisan AI Chatbot is running.\"}"
    ],
    "description": "FastAPI root endpoint for health check"
  },

  "FastAPI Chat Completion Endpoint": {
    "prefix": "fastapi-ask",
    "body": [
      "@app.post(\"/ask\")",
      "@app.post(\"/ask/chat/completions\")",
      "async def ask(request: Request):",
      "    data = await request.json()",
      "    messages = [{\"role\": \"user\", \"content\": data.get(\"question\")}] if \"question\" in data else data.get(\"messages\")",
      "    if not messages:",
      "        return {\"error\": \"Invalid request. Provide 'question' or 'messages'.\"}",
      "",
      "    response = query_engine.query(messages)",
      "    return {",
      "        \"choices\": [",
      "            {",
      "                \"message\": {",
      "                    \"role\": \"assistant\",",
      "                    \"content\": response",
      "                }",
      "            }",
      "        ],",
      "        \"model\": \"openai/gpt-4o-2024-11-20\"",
      "    }"
    ],
    "description": "POST endpoint for chatbot completion using OpenAI"
  },

  "LangGraph Workflow Setup": {
    "prefix": "langgraph-setup",
    "body": [
      "workflow = StateGraph(ChatState)",
      "workflow.add_node(\"retrieve_documents\", retrieve_documents)",
      "workflow.add_node(\"check_location\", check_location)",
      "workflow.add_node(\"generate_response\", generate_response)",
      "",
      "workflow.add_edge(\"retrieve_documents\", \"check_location\")",
      "workflow.add_edge(\"check_location\", \"generate_response\")",
      "workflow.add_edge(\"generate_response\", END)",
      "",
      "workflow.set_entry_point(\"retrieve_documents\")",
      "graph = workflow.compile()"
    ],
    "description": "LangGraph workflow for artisan chatbot"
  },

  "Query OpenAI using LangGraph": {
    "prefix": "query-openai-graph",
    "body": [
      "def query_openai(messages: List[Dict[str, str]]) -> str:",
      "    state = {\"messages\": messages, \"retrieved_content\": \"\", \"response\": \"\"}",
      "    result = graph.invoke(state)",
      "    return result[\"response\"]"
    ],
    "description": "Query OpenAI using LangGraph compiled workflow"
  },

  "Docker Compose OpenWebUI": {
    "prefix": "docker-openwebui",
    "body": [
      "version: '3.8'",
      "services:",
      "  openwebui:",
      "    image: ghcr.io/open-webui/open-webui:main",
      "    container_name: openwebui",
      "    ports:",
      "      - \"3000:8080\"",
      "    environment:",
      "      - OPENAI_API_BASE_URLS=http://host.docker.internal:8000/ask",
      "      - DEFAULT_MODELS=openai/gpt-4o-2024-11-20",
      "      - APP_TITLE=My Custom Assistant",
      "      - BOT_NAME=EyobBot",
      "      - WEBUI_AUTH=false",
      "    extra_hosts:",
      "      - \"host.docker.internal:host-gateway\"",
      "    volumes:",
      "      - openwebui_data:/app/backend/data",
      "",
      "volumes:",
      "  openwebui_data:"
    ],
    "description": "Docker Compose setup for OpenWebUI connected to local FastAPI chatbot"
  }
}
